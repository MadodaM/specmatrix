---
import { createClient } from '@supabase/supabase-js';
import '../../styles/global.css'; // Imports Tailwind CSS

// 1. Tell Astro which static pages to generate
export async function getStaticPaths() {
  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  
  console.log("Checking Env Variables:", url ? "URL Loaded" : "URL MISSING!");

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || process.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || process.env.PUBLIC_SUPABASE_ANON_KEY;

  if (!supabaseUrl || !supabaseKey) {
    throw new Error("Missing Supabase Environment Variables during build!");
  }

 const supabase = createClient(supabaseUrl, supabaseKey);
  
  // Fetch all slugs for all entities
  const { data: entities, error } = await supabase.from('entities').select('slug');
  
  if (error) console.error("Supabase Error:", error.message);
  console.log("Pages generated by Astro:", entities);
  
  return (entities || []).map((entity) => ({
    params: { slug: entity.slug },
  }));
}

// 2. Fetch the full record data for the current page
const { slug } = Astro.params;
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: entity, error } = await supabase
  .from('entities')
  .select(`
    model_name,
    year_start,
    year_end,
    specs,
    categories (name),
    brands (name),
    compatible_parts (part_name, part_number, affiliate_url)
  `)
  .eq('slug', slug)
  .single();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{entity?.brands?.name} {entity?.model_name} Specs | SpecMatrix</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`Full technical specifications and replacement parts for the ${entity?.brands?.name} ${entity?.model_name} (${entity?.year_start}-${entity?.year_end}).`} />
    
    <!-- JSON-LD Schema for Google Rich Results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": `${entity?.brands?.name} ${entity?.model_name}`,
      "brand": {
        "@type": "Brand",
        "name": entity?.brands?.name
      },
      "category": entity?.categories?.name,
      "releaseDate": entity?.year_start,
      "description": `Technical specifications and compatible parts for the ${entity?.brands?.name} ${entity?.model_name} (${entity?.year_start}-${entity?.year_end}).`
    })} />
  </head>
  <body class="bg-gray-50 text-gray-900 p-8 font-sans max-w-4xl mx-auto">
    
    {entity ? (
      <>
        <header class="mb-8 border-b pb-4 border-gray-200">
          <!-- Semantic Breadcrumbs -->
          <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="flex items-center space-x-2 text-sm text-gray-500 font-medium">
              <li><a href="/" class="hover:text-blue-600 transition-colors">Home</a></li>
              <li><span class="text-gray-400">/</span></li>
              <li class="capitalize">{entity.categories?.name}</li>
              <li><span class="text-gray-400">/</span></li>
              <li class="capitalize text-blue-600">{entity.brands?.name}</li>
            </ol>
          </nav>

          <h1 class="text-4xl font-extrabold mt-2 text-gray-900">
            {entity.brands?.name} {entity.model_name} <span class="text-gray-500 font-light">({entity.year_start}-{entity.year_end})</span>
          </h1>
        </header>

        <section class="mb-12 bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
          <h2 class="text-2xl font-bold p-6 border-b border-gray-200 bg-gray-50 text-gray-800">Technical Specifications</h2>
          <div class="grid grid-cols-1 divide-y divide-gray-100">
            {Object.entries(entity.specs).map(([key, value]) => (
              <div class="grid grid-cols-3 p-4 hover:bg-gray-50 transition-colors">
                <div class="font-semibold text-gray-500 capitalize">
                  {key.replace(/_/g, ' ')}
                </div>
                <div class="col-span-2 text-gray-900 font-medium">{value as string}</div>
              </div>
            ))}
          </div>
        </section>

        {entity.compatible_parts && entity.compatible_parts.length > 0 && (
          <section>
            <h2 class="text-xl font-bold mb-4 text-gray-800">Recommended Replacement Parts</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {entity.compatible_parts.map((part: any) => (
                <a href={part.affiliate_url} target="_blank" rel="noopener noreferrer" 
                   class="block p-4 bg-white border border-blue-200 rounded-lg shadow-sm hover:shadow-md transition-shadow border-l-4 border-l-blue-500">
                  <p class="font-bold text-lg text-gray-900">{part.part_name}</p>
                  <p class="text-sm text-gray-500 font-mono mt-1">Part #: {part.part_number}</p>
                  <p class="text-blue-600 text-sm font-semibold mt-2">Check Price & Availability &rarr;</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="text-red-500 font-bold">Error loading entity data. Check console.</div>
    )}

  </body>
</html>