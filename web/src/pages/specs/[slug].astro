---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: entities } = await supabase.from('entities').select('slug');

  return (entities || []).map((entity) => ({
    params: { slug: entity.slug },
  }));
}

const { slug } = Astro.params;

// Fetch current entity along with brands, categories, and compatible parts
const { data: entity } = await supabase
  .from('entities')
  .select(`
    *,
    brands ( name ),
    categories ( name ),
    compatible_parts ( part_name, part_number, affiliate_url )
  `)
  .eq('slug', slug)
  .single();

if (!entity) {
  return Astro.redirect('/404');
}

// Fetch related specifications within the same category for internal linking & PageRank flow
const { data: relatedEntities } = await supabase
  .from('entities')
  .select(`
    slug,
    model_name,
    year_start,
    year_end,
    brands ( name ),
    categories ( name )
  `)
  .eq('category_id', entity.category_id)
  .neq('id', entity.id)
  .limit(3);
---

<Layout 
  title={`${entity?.brands?.name} ${entity?.model_name} Specs | SpecMatrix`}
  description={`Full technical specifications and production timelines for the ${entity?.brands?.name} ${entity?.model_name} (${entity?.year_start}-${entity?.year_end || 'Present'}).`}
>
  <!-- JSON-LD Schema for Technical Reference Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org/",
    "@type": "TechArticle",
    "headline": `${entity?.brands?.name} ${entity?.model_name} Technical Specifications`,
    "description": `Comprehensive technical specifications, production timeline, and engineering data for the ${entity?.brands?.name} ${entity?.model_name} (${entity?.year_start}–${entity?.year_end || 'Present'}).`,
    "image": "https://specmatrix.io/og-image.jpg",
    "author": {
      "@type": "Organization",
      "name": "SpecMatrix Technical Editorial",
      "url": "https://specmatrix.io"
    },
    "publisher": {
      "@type": "Organization",
      "name": "SpecMatrix",
      "url": "https://specmatrix.io"
    }
  })} />

  <main class="min-h-screen bg-base-200 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto bg-base-100 rounded-2xl shadow-xl p-8 border border-base-300">
      
      <!-- Full Hierarchy Breadcrumbs -->
      <div class="text-sm breadcrumbs mb-6 text-base-content/70">
        <ul>
          <li><a href="/" class="hover:text-primary">Home</a></li>
          <li class="capitalize">{entity.categories?.name}</li>
          <li class="capitalize">{entity.brands?.name}</li>
          <li class="capitalize text-primary font-semibold">{entity.model_name}</li>
        </ul>
      </div>

      <!-- Header Section -->
      <header class="mb-8 border-b border-base-200 pb-6">
        <h1 class="text-4xl font-extrabold text-base-content">
          {entity.brands?.name} {entity.model_name} 
          <span class="text-base-content/50 font-light text-2xl">({entity.year_start}–{entity.year_end || 'Present'})</span>
        </h1>
      </header>

      <!-- Overview Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="stats shadow bg-base-200 border border-base-300">
          <div class="stat">
            <div class="stat-title">Category</div>
            <div class="stat-value text-lg capitalize">{entity.categories?.name}</div>
          </div>
        </div>
        <div class="stats shadow bg-base-200 border border-base-300">
          <div class="stat">
            <div class="stat-title">Production Timeline</div>
            <div class="stat-value text-lg">{entity.year_start} – {entity.year_end || 'Present'}</div>
          </div>
        </div>
      </div>

      <!-- Layout Grid: Specs on Left, Ad on Right -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        
        <!-- Left Column: Specs -->
        <div class="lg:col-span-2">
          <section>
            <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-200 pb-2">Technical Specifications</h2>
            {entity.specs && Object.keys(entity.specs).length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {Object.entries(entity.specs).map(([key, value]) => (
                  <div class="flex justify-between items-center p-4 bg-base-200/50 rounded-lg border border-base-300">
                    <span class="font-medium text-base-content/70 capitalize">{key.replace(/_/g, ' ')}</span>
                    <span class="font-bold text-base-content">{String(value)}</span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-base-content/50 italic">No detailed specifications available for this entry.</p>
            )}
          </section>
        </div>

        <!-- Right Column: Zero-CLS Sidebar Ad -->
        <aside class="lg:col-span-1">
          <div class="sticky top-8">
            <!-- The min-h-[300px] class prevents layout shift when the ad loads -->
            <div class="w-full min-h-[300px] bg-base-200/30 border border-base-300 border-dashed rounded-xl flex items-center justify-center">
              <span class="text-base-content/40 text-sm">Advertisement Slot</span>
            </div>
          </div>
        </aside>

      </div>

      <!-- Compatible Parts & Monetization Block -->
      {entity.compatible_parts && entity.compatible_parts.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-base-content mb-4 border-b border-base-200 pb-2">
            Compatible Parts & Replacement Components
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {entity.compatible_parts.map((part) => (
              <div class="flex items-center justify-between p-4 bg-base-200/50 rounded-xl border border-base-300">
                <div>
                  <h3 class="font-semibold text-base-content">{part.part_name}</h3>
                  {part.part_number && (
                    <p class="text-xs text-base-content/60 mt-0.5">OEM Ref: {part.part_number}</p>
                  )}
                </div>
                {part.affiliate_url && (
                  <a
                    href={`/go?to=${encodeURIComponent(part.affiliate_url)}&part=${encodeURIComponent(part.part_name)}`}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="btn btn-sm btn-primary ml-4"
                  >
                    View Pricing
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Related Specifications Block -->
      {relatedEntities && relatedEntities.length > 0 && (
        <section class="border-t border-base-200 pt-8">
          <h2 class="text-xl font-bold text-base-content mb-4">Related {entity.categories?.name} Specifications</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedEntities.map((item) => (
              <a href={`/specs/${item.slug}`} class="p-4 bg-base-200/60 rounded-xl border border-base-300 hover:border-primary transition-all">
                <h3 class="font-bold text-base-content text-sm">{item.brands?.name} {item.model_name}</h3>
                <p class="text-xs text-base-content/60 mt-1">{item.year_start} – {item.year_end || 'Present'}</p>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>
</Layout>