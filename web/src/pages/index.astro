---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: entities } = await supabase
  .from('entities')
  .select(`
    *,
    brands ( name ),
    categories ( name )
  `)
  .order('created_at', { ascending: false });
---

<Layout title="SpecMatrix | Programmatic Technical Specifications Network">
  <main class="min-h-screen bg-base-200 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      
      <!-- Hero Header -->
      <div class="text-center mb-12">
        <h1 class="text-5xl font-black tracking-tight text-base-content mb-3">SpecMatrix</h1>
        <p class="text-lg text-base-content/70">Programmatic Technical Specifications & Equipment Data Network</p>
      </div>

      <!-- Grid of Entities -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {entities && entities.map((entity) => (
          <a href={`/specs/${entity.slug}`} class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all hover:-translate-y-1">
            <div class="card-body">
              <div>
                <span class="badge badge-primary badge-outline font-semibold uppercase tracking-wider mb-2">
                  {entity.categories?.name}
                </span>
              </div>
              <h2 class="card-title text-xl font-bold text-base-content">
                {entity.brands?.name} {entity.model_name}
              </h2>
              <p class="text-sm text-base-content/60 mt-1">
                Production Years: <span class="font-medium text-base-content">{entity.year_start} – {entity.year_end || 'Present'}</span>
              </p>
              <div class="card-actions justify-end mt-4">
                <span class="btn btn-sm btn-primary">View Specs &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>
</Layout>