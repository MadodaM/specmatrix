---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: entities } = await supabase
  .from('entities')
  .select(`
    *,
    brands ( name ),
    categories ( name )
  `)
  .order('created_at', { ascending: false });
---

<Layout title="SpecMatrix | Programmatic Technical Specifications Network">
  <main class="bg-gray-50 text-gray-900 font-sans p-6 md:p-12 min-h-screen">
    <div class="max-w-5xl mx-auto">
      <header class="mb-10 text-center">
        <h1 class="text-5xl font-black tracking-tight text-gray-900 mb-3">SpecMatrix</h1>
        <p class="text-lg text-gray-600">Programmatic Technical Specifications & Equipment Data Network</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {entities && entities.map((entity) => (
          <a href={`/specs/${entity.slug}`} class="block p-6 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow border border-gray-200">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full mb-3 inline-block">
              {entity.categories?.name}
            </span>
            <h2 class="text-xl font-bold text-gray-900 mt-1">
              {entity.brands?.name} {entity.model_name}
            </h2>
            <p class="text-sm text-gray-500 mt-2">
              Years: {entity.year_start} – {entity.year_end || 'Present'}
            </p>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>